<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.8" moduleId="AquiIoT_bateria_18650_v1">
  <version>1</version>
  <title>Bateria de lítio 18650 3,7 V (com suporte)</title>
  <label>BAT</label>
  <date>2026-11-06</date>
  <author>AquiIoT (UNIPAMPA)</author>
  <tags>
    <tag>18650</tag>
    <tag>bateria</tag>
    <tag>lítio</tag>
    <tag>AquiIoT</tag>
  </tags>
  <properties>
    <property name="family">battery</property>
    <property name="voltage">3.7V</property>
    <property name="formato">18650</property>
  </properties>
  <description>Célula de íon-lítio 18650, 3,7 V nominal (4,2 V carregada), em suporte com fios. Peça criada para o projeto AquiIoT.</description>
  <views>
    <iconView><layers image="icon/aquiiot_bateria_18650_icon.svg"><layer layerId="icon"/></layers></iconView>
    <breadboardView><layers image="breadboard/aquiiot_bateria_18650_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
    <schematicView><layers image="schematic/aquiiot_bateria_18650_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
    <pcbView><layers image="pcb/aquiiot_bateria_18650_pcb.svg"><layer layerId="copper0"/><layer layerId="silkscreen"/><layer layerId="copper1"/></layers></pcbView>
  </views>
  <connectors>
    <connector id="connector0" name="+" type="male">
      <description>Positivo (3,0–4,2 V)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector0pad"/><p layer="copper1" svgId="connector0pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector1" name="-" type="male">
      <description>Negativo</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector1pad"/><p layer="copper1" svgId="connector1pad"/></pcbView>
      </views>
    </connector>
  </connectors>
</module>
