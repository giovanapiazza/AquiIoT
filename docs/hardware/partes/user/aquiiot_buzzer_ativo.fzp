<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.8" moduleId="AquiIoT_buzzer_ativo_v1">
  <version>1</version>
  <title>Buzzer ativo 12 mm (2 pinos)</title>
  <label>BZ</label>
  <date>2026-11-06</date>
  <author>AquiIoT (UNIPAMPA)</author>
  <tags>
    <tag>buzzer</tag>
    <tag>ativo</tag>
    <tag>AquiIoT</tag>
  </tags>
  <properties>
    <property name="family">buzzer</property>
    <property name="tipo">ativo</property>
    <property name="tensão">3–5 V</property>
  </properties>
  <description>Buzzer ativo de 12 mm com oscilador interno: soa com nível alto no pino +. Pinos a 0,3" (7,6 mm). Peça criada para o projeto AquiIoT.</description>
  <views>
    <iconView><layers image="icon/aquiiot_buzzer_ativo_icon.svg"><layer layerId="icon"/></layers></iconView>
    <breadboardView><layers image="breadboard/aquiiot_buzzer_ativo_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
    <schematicView><layers image="schematic/aquiiot_buzzer_ativo_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
    <pcbView><layers image="pcb/aquiiot_buzzer_ativo_pcb.svg"><layer layerId="copper0"/><layer layerId="silkscreen"/><layer layerId="copper1"/></layers></pcbView>
  </views>
  <connectors>
    <connector id="connector0" name="-" type="male">
      <description>Negativo (GND)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector0pad"/><p layer="copper1" svgId="connector0pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector1" name="+" type="male">
      <description>Positivo (sinal do GPIO)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector1pad"/><p layer="copper1" svgId="connector1pad"/></pcbView>
      </views>
    </connector>
  </connectors>
</module>
