<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.8" moduleId="AquiIoT_esp01s_v1">
  <version>1</version>
  <title>ESP-01S (ESP8266)</title>
  <label>U</label>
  <date>2026-11-06</date>
  <author>AquiIoT (UNIPAMPA)</author>
  <tags>
    <tag>ESP8266</tag>
    <tag>ESP-01S</tag>
    <tag>AquiIoT</tag>
  </tags>
  <properties>
    <property name="family">microcontroller board (esp8266)</property>
    <property name="chip">ESP8266EX</property>
    <property name="flash">1 MB</property>
  </properties>
  <description>Módulo ESP-01S com ESP8266EX, 1 MB de flash e antena na placa. Pinos 2x4 de 0,1". O ESP-01S já traz pull-ups em EN e RST. Peça criada para o projeto AquiIoT.</description>
  <views>
    <iconView><layers image="icon/aquiiot_esp01s_icon.svg"><layer layerId="icon"/></layers></iconView>
    <breadboardView><layers image="breadboard/aquiiot_esp01s_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
    <schematicView><layers image="schematic/aquiiot_esp01s_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
    <pcbView><layers image="pcb/aquiiot_esp01s_pcb.svg"><layer layerId="copper0"/><layer layerId="silkscreen"/><layer layerId="copper1"/></layers></pcbView>
  </views>
  <connectors>
    <connector id="connector0" name="GND" type="male">
      <description>Terra</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector0pad"/><p layer="copper1" svgId="connector0pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector1" name="GPIO2" type="male">
      <description>GPIO2 (LED azul no ESP-01S); precisa estar em nível alto no boot</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector1pad"/><p layer="copper1" svgId="connector1pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector2" name="GPIO0" type="male">
      <description>GPIO0: nível baixo no boot = modo de gravação</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector2pad"/><p layer="copper1" svgId="connector2pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector3" name="RXD" type="male">
      <description>UART RX (GPIO3)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector3pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector3pin" terminalId="connector3terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector3pad"/><p layer="copper1" svgId="connector3pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector4" name="TXD" type="male">
      <description>UART TX (GPIO1)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector4pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector4pin" terminalId="connector4terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector4pad"/><p layer="copper1" svgId="connector4pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector5" name="EN" type="male">
      <description>CH_PD/EN: já tem pull-up de 12 kΩ no ESP-01S</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector5pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector5pin" terminalId="connector5terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector5pad"/><p layer="copper1" svgId="connector5pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector6" name="RST" type="male">
      <description>Reset (ativo em nível baixo), com pull-up no ESP-01S</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector6pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector6pin" terminalId="connector6terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector6pad"/><p layer="copper1" svgId="connector6pad"/></pcbView>
      </views>
    </connector>
    <connector id="connector7" name="3V3" type="male">
      <description>Alimentação 3,3 V (não tolera 5 V)</description>
      <views>
        <breadboardView><p layer="breadboard" svgId="connector7pin"/></breadboardView>
        <schematicView><p layer="schematic" svgId="connector7pin" terminalId="connector7terminal"/></schematicView>
        <pcbView><p layer="copper0" svgId="connector7pad"/><p layer="copper1" svgId="connector7pad"/></pcbView>
      </views>
    </connector>
  </connectors>
</module>
